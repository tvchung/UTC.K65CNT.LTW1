@model TvcLesson08DF.Models.Category

@{
    ViewData["Title"] = "Thêm mới Loại sách";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">Thêm mới Loại sách</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="CategoryName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="CategoryName" class="form-control" placeholder="Nhập tên loại sách..." />
                            <span asp-validation-for="CategoryName" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-secondary">
                                &larr; Quay lại danh sách
                            </a>
                            <button type="submit" class="btn btn-primary">
                                Lưu lại
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
