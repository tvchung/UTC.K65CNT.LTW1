@model TvcLesson08DF.Models.Publisher

@{
    ViewData["Title"] = "Chi tiết Nhà xuất bản";
}

<div class="container py-3">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Chi tiết Nhà xuất bản: @Model.PublisherName</h5>
            <span class="badge bg-light text-dark">ID: #@Model.PublisherId</span>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.PublisherId)</dt>
                <dd class="col-sm-9 fw-bold">@Model.PublisherId</dd>

                <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.PublisherName)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.PublisherName)</dd>

                <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.Phone)</dt>
                <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</dd>

                <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.Address)</dt>
                <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)</dd>
            </dl>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">&larr; Quay lại danh sách</a>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.PublisherId" class="btn btn-warning">Sửa</a>
                <a asp-action="Delete" asp-route-id="@Model.PublisherId" class="btn btn-danger">Xóa</a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h6 class="mb-0">Danh sách sách thuộc nhà xuất bản này (@Model.Books.Count quyển)</h6>
        </div>
        <div class="card-body p-0">
            @if (!Model.Books.Any())
            {
                <div class="p-3 text-muted text-center">Chưa có cuốn sách nào thuộc nhà xuất bản này.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã sách</th>
                                <th>Tiêu đề</th>
                                <th>Tác giả</th>
                                <th>Giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var book in Model.Books)
                            {
                                <tr>
                                    <td>@book.BookId</td>
                                    <td>@book.Title</td>
                                    <td>@book.Author</td>
                                    <td>@(book.Price.HasValue ? string.Format("{0:N0} đ", book.Price) : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
