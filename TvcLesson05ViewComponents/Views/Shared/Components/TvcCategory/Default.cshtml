@model IEnumerable<TvcLesson05ViewComponents.Models.TvcCategory>

<ul class="list-group  my-3">
    <li class="list-group-item active"> DANH MỤC</li>
    @foreach (var item in Model)
    {
        <li class="list-group-item">
            <a asp-controller="TvcProduct" asp-action="Index" asp-route-categoryId="@item.CategoryId">
                    @item.CategoryName
            </a>
            @* <a href="/tvcproduct/index/@item.CategoryId"> @item.CategoryName </a> *@
        </li>
    }
</ul>