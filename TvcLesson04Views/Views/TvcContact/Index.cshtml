
@{
    ViewData["Title"] = "Cú pháp Razor";
}

<div>
    <h1>@ViewData["Title"]</h1>
    @{
        var name = "Chung Trịnh";
        int age = 47;
        string email = "chungtrinhj@gmail.com";
    }
    <div class="alert alert-danger">
        <p>Họ và tên: @name</p>
        <p>Tuổi: @age</p>
        <p>Email: @email</p>
    </div>

    @{
        var greeting = "Xin chào, " + name + "! Chúc bạn thành công";
        var weekday = DateTime.Now.DayOfWeek;
        var greetingWithDate = greeting + " Hôm nay là " + weekday.ToString();
    }
    <h2>@greeting </h2>
    <h3>@greetingWithDate</h3>
</div>
<div>
    <h2>Cấu trúc điểu khiển: if, switch</h2>
    @if (age < 18)
    {
        <p class="alert alert-success">Bạn chưa đủ tuổi trưởng thành</p>
    }
    else if (age >= 18 && age < 60)
    {
        <p class="alert alert-info">Bạn là người trưởng thành</p>
    }
    else
    {
        <p class="alert alert-warning"> Bạn là người cao tuổi</p>
    }

</div>
<div>
    <h2>Cấu trúc lặp: for, foreach, ....</h2>
    <hr/>
    @for (int i = 0; i < 10; i++)
    {
        if(i % 2 == 0)
        {
            <button class="btn btn-danger">@i</button>
        }
        else
        {
            <button class="btn btn-success">@i</button>
        }      
    }
</div>